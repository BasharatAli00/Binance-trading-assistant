# ─────────────────────────────────────────────────────────────────────────────
# Example environment for the backend. Copy to backend/.env and fill in.
# NEVER commit real values. On Azure, set these under App Service ->
# Settings -> Environment variables.
#
# This file documents the Robinhood Chain (RHC) system added in Phase 1.
# Existing variables (DATABASE_URL, JWT_SECRET_KEY, BINANCE_*, COPYTRADE_*, CT_*,
# HELIUS_*, QUICKNODE_*, PG_*, ROBINHOOD_* ...) are unchanged and not listed here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Robinhood Chain system: master switches ──────────────────────────────────
# Everything is OFF unless RHC_ENABLED=true AND RHC_DATABASE_URL is set.
RHC_ENABLED=false
RHC_INDEXER_ENABLED=true
RHC_SOURCES_ENABLED=true
# Live trading is hard-disabled in code (paper mode only); there is no env switch.

# Dedicated database for RHC data (a separate free Supabase project).
# Use the "Session pooler" connection string. RHC never uses DATABASE_URL.
RHC_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── RPC ──────────────────────────────────────────────────────────────────────
# Comma-separated failover list. Defaults to ROBINHOOD_RPC_URL or the public RPC.
# RHC_RPC_URLS=https://rpc.mainnet.chain.robinhood.com
# RHC_RPC_MAX_RPS=8
# RHC_RPC_TIMEOUT_S=20

# ── Indexer ──────────────────────────────────────────────────────────────────
# RHC_CONFIRMATIONS=20
# RHC_POLL_INTERVAL_S=2
# RHC_START_LOOKBACK_BLOCKS=6000      # ~10 min of history on first start
# RHC_MAX_CATCHUP_BLOCKS=830000       # ~1 day; longer downtime is recorded as a gap
# RHC_RESOLVE_TRADERS=true            # unique-trader counts via eth_getTransactionByHash

# ── Tracking (which pools get candles stored) ────────────────────────────────
# RHC_MAX_TRACKED_POOLS=100
# RHC_TRACK_MIN_VOL_USD_1H=5000
# RHC_TRACK_MIN_SWAPS_1H=20
# RHC_UNTRACK_IDLE_MIN=120

# Liquidity events: removals always stored; adds only when priced and >= this USD value.
# RHC_LIQ_ADD_MIN_USD=1000
# RHC_LIQ_STORE_ALL_ADDS=false

# ── Storage guard (free tier = 500 MB) ───────────────────────────────────────
# RHC_DB_BUDGET_MB=400
# RHC_PRUNE_AT_PCT=70
# RHC_PAUSE_AT_PCT=90
# RHC_RESUME_BELOW_PCT=80
# RHC_RETAIN_1M_HOURS=72
# RHC_RETAIN_5M_DAYS=30               # older 5m candles roll up to 15m

# ── Discovery & screening (Phase 2) ──────────────────────────────────────────
# RHC_SCREENER_ENABLED=true
# RHC_SCREEN_TRADE_USD=25            # intended trade size the simulation uses
# RHC_MIN_LIQ_USD=25000
# RHC_MAX_BUY_TAX=0.05
# RHC_MAX_SELL_TAX=0.05
# RHC_MAX_ROUNDTRIP_COST=0.04
# RHC_MAX_IMPACT=0.02
# RHC_MAX_TOP10_PCT=50
# RHC_SEVERITY_OVERRIDES=            # e.g. WASH_SUSPECT=warn,LP_NOT_BURNED=reject

# ── Signals, decisions & risk (Phase 3; paper only, intents are not executed) ─
# RHC_DECISIONS_ENABLED=true
# RHC_PAPER_EQUITY_USD=1000
# RHC_RISK_PCT=0.01
# RHC_MAX_POSITION_USD=50
# RHC_MAX_OPEN=5
# RHC_MAX_DAILY_LOSS_PCT=0.03
# RHC_KILL_SWITCH=false               # also switchable via POST /api/rhc/kill-switch
# RHC_STRAT_SMART_ENABLED=false       # keep off until /api/rhc/research/smart-money shows lift

# ── External sources (public endpoints, no keys needed) ──────────────────────
# RHC_DS_MAX_PER_MIN=120
# RHC_GT_MAX_PER_MIN=20
# RHC_SNAPSHOT_INTERVAL_S=300
# RHC_SNAPSHOT_TOP_N=20
# RHC_XCHECK_MAX_DEV_PCT=5
